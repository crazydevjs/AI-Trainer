# ============================================================
# FORGE — Environment Variables (copy to .env and fill in)
# ============================================================

# --- Database (PostgreSQL) ---
# Free options: Neon (neon.tech) or Supabase (supabase.com)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/forge?sslmode=require"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth / JWT ---
# Generate with:  openssl rand -base64 48
# Required in production — the app fails to boot without it (no insecure
# fallback outside of local development).
JWT_SECRET="change-me-to-a-long-random-secret"

# HMAC secret for signed storage URLs. Same requirement as JWT_SECRET:
# required in production, dev-only fallback otherwise.
SIGNING_SECRET="change-me-to-a-long-random-secret"

# --- Google OAuth ---
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (SMTP) for verification / password reset ---
# In dev, if SMTP_HOST is empty, links are printed to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FORGE <no-reply@forge.app>"

# --- OpenAI (AI coaching / plan generation) ---
# Currently unused — src/lib/coach.ts is fully local/offline (canned
# strings, no network calls). Documented here for whenever a real LLM
# is wired in; safe to leave blank until then.
OPENAI_API_KEY=""

# --- Optional platform tuning (all have safe defaults if unset) ---
# CDN origin for the storage provider's public asset URLs, if you put one
# in front of it. Leave unset to serve directly.
NEXT_PUBLIC_CDN_URL=""
# JSON array of FlagRule objects the flag store seeds at boot, e.g.
# '[{"key":"someFlag","enabled":true,"rolloutPercentage":100}]'. Leave
# unset to start with just the built-in engine on/off flags.
FEATURE_FLAGS_JSON=""
# One of "debug"|"info"|"warn"|"error". Defaults to "info".
LOG_LEVEL=""

# --- Stripe (billing — test mode only for the v1 Beta) ---
# Leave all four empty to keep using the in-memory mock billing provider
# (fine for local dev with no real subscriptions). Get test-mode keys at
# https://dashboard.stripe.com/test/apikeys — create two test Products
# with recurring Prices for "pro" and "elite" and paste each Price id
# below. Register the webhook (`stripe listen --forward-to
# localhost:3000/api/billing/webhook` locally, or a real endpoint once
# deployed) to get STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ELITE=""
