// FORGE — AI Fitness Trainer · Database Schema
// Provider: PostgreSQL · ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USER
// ============================================================

enum Role {
  USER
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String? // null for Google-only accounts
  image           String?
  googleId        String?   @unique
  role            Role      @default(USER)
  emailVerified   DateTime?
  onboarded       Boolean   @default(false)
  tokenVersion    Int       @default(0) // bumped to invalidate all outstanding session JWTs

  // gamification snapshot
  xp              Int       @default(0)
  level           Int       @default(1)
  streak          Int       @default(0)
  longestStreak   Int       @default(0)
  lastActiveDate  DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile         Profile?
  plan            WorkoutPlan?
  sessions        WorkoutSession[]
  workoutLogs     WorkoutLog[]
  progress        ProgressEntry[]
  records         PersonalRecord[]
  achievements    UserAchievement[]
  notifications   Notification[]
  tokens          Token[]
  customWorkouts  CustomWorkout[]
  subscription    Subscription?

  // Phase 7 — Performance Intelligence & Persistence Layer (all additive)
  performanceSnapshots PerformanceSnapshot[]
  weaknessHistory      WeaknessHistory[]
  personalBests        PersonalBest[]
  trendHistory         TrendHistory[]
  statistics           UserStatistics?

  // Phase 8 — Personalized Learning Engine (all additive)
  learningProfile           UserLearningProfile?
  adaptiveThresholds        AdaptiveThreshold[]
  learnedWeaknesses         LearnedWeakness[]
  recommendationEffectiveness RecommendationEffectiveness[]
  goalProfile               GoalProfile?
  progressPredictions       ProgressPrediction[]

  @@index([email])
}

// Email-verification & password-reset tokens
enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Token {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

// Phase 21 — persisted backing store for src/lib/platform/subscriptions/
// (previously an in-memory Map). Stripe test-mode only for the v1 Beta —
// see src/lib/platform/billing/providers/stripe-provider.ts.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String             @default("free")
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// ============================================================
// ONBOARDING PROFILE
// ============================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FitnessGoal {
  LOSE_WEIGHT
  BUILD_MUSCLE
  GAIN_STRENGTH
  IMPROVE_ENDURANCE
  STAY_FIT
  RECOMP
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum WorkoutLocation {
  HOME
  GYM
  OUTDOOR
  HYBRID
}

model Profile {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  age           Int
  gender        Gender
  heightCm      Float
  weightKg      Float
  targetWeightKg Float?

  goal          FitnessGoal
  experience    ExperienceLevel
  activityLevel ActivityLevel
  location      WorkoutLocation

  injuries      String[]        @default([])
  equipment     String[]        @default([])
  dailyMinutes  Int             @default(45) // available time per day
  workoutDays   Int             @default(4)  // days per week

  // Computed metrics
  bmi           Float?
  bmr           Float?
  dailyCalories Float?
  fitnessScore  Int? // 0-100

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ============================================================
// EXERCISE LIBRARY
// ============================================================

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExerciseCategory {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  CARDIO
  FUNCTIONAL
  OLYMPIC
  FULL_BODY
}

// Training discipline tags an exercise belongs to.
enum Discipline {
  GYM
  HOME
  POWERLIFTING
  BODYBUILDING
  CALISTHENICS
  CARDIO
  FUNCTIONAL
  CROSSFIT
}

enum EquipmentType {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  CARDIO_MACHINE
  ACCESSORY
}

// Equipment & machine catalog (reference + filtering).
model Equipment {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  type      EquipmentType
  imageUrl  String?
  createdAt DateTime      @default(now())
}

model Exercise {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  category       ExerciseCategory
  difficulty     Difficulty
  disciplines    Discipline[]     @default([])

  // Muscles
  muscles          String[] @default([]) // primary
  secondaryMuscles String[] @default([])

  // Gear (denormalized for fast display; see Equipment catalog for the registry)
  equipment      String[]         @default([])

  // Coaching content
  instructions   String[]         @default([])
  commonMistakes String[]         @default([])
  formTips       String[]         @default([])
  beginnerMod    String?
  advancedVariations String[]     @default([])

  // Media
  videoUrl       String?
  imageUrl       String?

  // Energy
  metValue       Float            @default(5) // for calorie estimation

  // AI camera support
  poseKey        String? // which pose rep-counter logic applies (e.g. "squat")
  aiPosture      Boolean          @default(false)
  aiRepCount     Boolean          @default(false)
  aiRom          Boolean          @default(false)
  aiFeedback     Boolean          @default(false)

  createdAt      DateTime         @default(now())

  planExercises          PlanExercise[]
  sessions               WorkoutSession[]
  records                PersonalRecord[]
  customWorkoutExercises CustomWorkoutExercise[]

  // Phase 7 — Performance Intelligence & Persistence Layer (all additive)
  performanceSnapshots   PerformanceSnapshot[]
  weaknessHistory        WeaknessHistory[]
  personalBests          PersonalBest[]
  trendHistory           TrendHistory[]

  // Phase 8 — Personalized Learning Engine (all additive)
  adaptiveThresholds      AdaptiveThreshold[]
  learnedWeaknesses       LearnedWeakness[]
  progressPredictions     ProgressPrediction[]
}

// ============================================================
// PERSONALIZED PLAN
// ============================================================

model WorkoutPlan {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  summary   String?
  createdAt DateTime   @default(now())
  days      PlanDay[]
}

model PlanDay {
  id        String         @id @default(cuid())
  planId    String
  plan      WorkoutPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0-6
  focus     String // e.g. "Push", "Pull", "Legs", "Rest"
  exercises PlanExercise[]
}

model PlanExercise {
  id         String   @id @default(cuid())
  dayId      String
  day        PlanDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  order      Int      @default(0)
  sets       Int      @default(3)
  reps       Int      @default(10)
  restSec    Int      @default(60)
}

// ============================================================
// WORKOUT CREATOR (user-built workouts & programs)
// ============================================================

enum ProgramType {
  CUSTOM
  PUSH_PULL_LEGS
  UPPER_LOWER
  FULL_BODY
  POWERLIFTING
  BRO_SPLIT
}

model CustomWorkout {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  programType ProgramType             @default(CUSTOM)
  isFavorite  Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  exercises   CustomWorkoutExercise[]

  @@index([userId, isFavorite])
}

model CustomWorkoutExercise {
  id         String        @id @default(cuid())
  workoutId  String
  workout    CustomWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise      @relation(fields: [exerciseId], references: [id])
  order      Int           @default(0)
  sets       Int           @default(3)
  reps       Int           @default(10)
  restSec    Int           @default(60)
}

// ============================================================
// WORKOUT SESSIONS & ANALYSIS
// ============================================================

// A complete gym session (the user's training-log entry): one titled workout
// containing many exercises. Child per-exercise data lives in WorkoutSession.
model WorkoutLog {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  description    String?

  startedAt      DateTime         @default(now())
  endedAt        DateTime?
  durationSec    Int              @default(0)

  totalExercises Int              @default(0)
  totalSets      Int              @default(0)
  totalReps      Int              @default(0)
  totalVolumeKg  Float            @default(0)
  prCount        Int              @default(0)

  // AI coach post-workout observation (rendered in summary + share card)
  summary        String?

  exercises      WorkoutSession[]

  // Phase 7 — Performance Intelligence & Persistence Layer (additive)
  performanceSnapshots PerformanceSnapshot[]

  @@index([userId, startedAt])
}

model WorkoutSession {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise     @relation(fields: [exerciseId], references: [id])

  // parent gym session (null for legacy single-exercise AI sessions)
  workoutLogId  String?
  workoutLog    WorkoutLog?  @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  targetSets    Int
  targetReps    Int

  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  durationSec   Int          @default(0)

  totalReps     Int          @default(0)
  caloriesBurned Float       @default(0)

  // AI session analysis (0-100 unless noted)
  overallScore  Float? // out of 10
  formScore     Float?
  romScore      Float? // range of motion
  tempoScore    Float?
  consistencyScore Float?
  completionPct Float?
  feedback      String[]     @default([])

  sets          SessionSet[]

  // Phase 7 — Performance Intelligence & Persistence Layer (all additive).
  // The rich per-engine analysis (Form/Movement/Injury-Risk Engine output)
  // that used to stay client-side only — see ALGORITHM.md "Performance
  // Intelligence & Persistence Layer".
  formAnalysis      SessionFormAnalysis?
  movementAnalysis  SessionMovementAnalysis?
  riskAnalysis      SessionRiskAnalysis?
  performanceSnapshot PerformanceSnapshot?
  personalBests     PersonalBest[]

  @@index([userId, startedAt])
  @@index([workoutLogId])
}

model SessionSet {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  setNumber  Int
  reps       Int            @default(0)
  targetReps Int? // planned reps for this set, distinct from `reps` (actual)
  failed     Boolean        @default(false) // ended at failure, short of target
  weightKg   Float?
  formScore  Float?
  romScore   Float?
}

// ============================================================
// PERFORMANCE INTELLIGENCE & PERSISTENCE LAYER (Phase 7)
//
// Post-workout only — nothing here is written or read during a live
// session. Persists the Form/Movement/Injury-Risk Engines' full analysis
// (previously computed client-side only, never sent to the server) plus
// cross-session historical learning: weakness trends, personal bests,
// progress trends, and aggregate user statistics. See ALGORITHM.md
// "Performance Intelligence & Persistence Layer".
//
// Deep, event/time-series-shaped data (per-frame score history, issue
// logs, risk timelines) is stored as `Json` rather than fully normalized —
// at "millions of sessions" scale, exploding 1Hz score samples into rows
// would dwarf every other table for little query benefit. Aggregate/
// queryable fields (scores, counts, trend labels) are normalized columns.
// ============================================================

// One row per WorkoutSession — the Form Analysis Engine's session rollup.
model SessionFormAnalysis {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  jointScore           Float
  alignmentScore       Float
  balanceScore         Float
  romScore             Float
  stabilityScore       Float
  movementQualityScore Float
  techniqueScore       Float
  overallScore         Float

  topIssues          String[] @default([])
  hasExerciseProfile Boolean  @default(false)

  issueLog     Json // IssueLogEntry[] — see form-engine/types.ts
  scoreHistory Json // { t, scores }[]
  weaknesses   Json // WeaknessTrend[]

  createdAt DateTime @default(now())

  @@index([sessionId])
}

// One row per WorkoutSession — the Movement Intelligence Engine's rollup.
model SessionMovementAnalysis {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  smoothnessScore   Float
  controlScore      Float
  coordinationScore Float
  symmetryScore     Float
  consistencyScore  Float
  stabilityScore    Float
  efficiencyScore   Float
  overallScore      Float

  dominantSide String?
  strengths    String[] @default([])
  weaknesses   String[] @default([])
  focusAreas   String[] @default([])

  scoreHistory Json // { t, scores }[]
  consistency  Json // ConsistencySummary
  symmetry     Json // SymmetrySummary
  compensation Json // CompensationSummary
  trend        Json // TrendSummary

  createdAt DateTime @default(now())

  @@index([sessionId])
}

// One row per WorkoutSession — the Injury Risk Engine's rollup.
model SessionRiskAnalysis {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  highestRisk      Float
  averageRisk      Float
  riskTrend        String // TrendDirection, stored as a plain string — see
                           // ALGORITHM.md "Independence from the runtime engines"
  mostCommonCauses String[] @default([])

  riskTimeline          Json // RiskTimelineEntry[]
  recommendationHistory Json // RecommendationHistoryEntry[]

  createdAt DateTime @default(now())

  @@index([sessionId])
}

// The Performance Engine's 8-dimension score. One row per completed
// exercise-in-a-session (-> workoutSessionId) or per whole gym session
// (-> workoutLogId) — naturally append-only, so this table also doubles as
// the historical score-over-time log (TrendHistory is the cached rollup
// of it, not a replacement for it).
model PerformanceSnapshot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutLogId String?
  workoutLog   WorkoutLog? @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  workoutSessionId String?         @unique
  workoutSession   WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  workoutScore     Float?
  exerciseScore    Float?
  consistencyScore Float?
  techniqueScore   Float?
  strengthScore    Float?
  recoveryScore    Float?
  volumeScore      Float?
  overallScore     Float

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([workoutLogId])
}

// One row per (user, exercise-or-null, issueId) — upserted every session
// that detects the same recurring technique/compensation issue. issueId
// is a form-engine IssueId or movement-engine CompensationId, stored as a
// plain string (see "Independence from the runtime engines").
model WeaknessHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  issueId String
  source  String // "form" | "movement"

  frequency      Int      @default(1)
  severity       String // last-seen severity label
  trend          String // TrendDirection
  improvementPct Float?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, exerciseId, issueId])
  @@index([userId, lastSeenAt])
}

enum PersonalBestCategory {
  HIGHEST_WEIGHT
  MOST_REPS
  MOST_VOLUME
  LONGEST_WORKOUT
  BEST_TECHNIQUE
  BEST_CONSISTENCY
  BEST_SYMMETRY
  BEST_MOVEMENT_SCORE
  BEST_PERFORMANCE_SCORE
}

// One row per (user, exercise-or-null, category). exerciseId is null for
// workout-level categories (LONGEST_WORKOUT, BEST_CONSISTENCY, etc.) that
// aren't tied to a single exercise — see ALGORITHM.md "Known limitations"
// for why those rows can't rely on the compound-unique constraint alone.
model PersonalBest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  category PersonalBestCategory
  value    Float

  workoutSessionId String?
  workoutSession   WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)

  achievedAt DateTime @default(now())

  @@unique([userId, exerciseId, category])
  @@index([userId, category])
}

// One upserted "current state" row per (user, exercise-or-null) — a cached
// rollup for fast trend lookups; the historical log itself lives in
// PerformanceSnapshot.
model TrendHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String? // null = overall, across all exercises
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  sevenSessionTrend String // TrendDirection
  thirtyDayTrend    String
  ninetyDayTrend    String

  rollingAvgScore  Float?
  improvementPct   Float?
  regressionPct    Float?
  sessionsAnalyzed Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, exerciseId])
}

// One row per user — aggregates this phase introduces that don't belong on
// User itself (which already has its own xp/level/streak gamification
// fields, untouched by this phase).
model UserStatistics {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionsAnalyzed         Int      @default(0)
  avgPerformanceScore      Float?
  avgTechniqueScore        Float?
  bestPerformanceScore     Float?
  totalPerfectReps         Int      @default(0)
  totalPerfectSessions     Int      @default(0)
  consistencyStreak        Int      @default(0)
  longestConsistencyStreak Int      @default(0)

  lastAnalyzedAt DateTime?
  updatedAt      DateTime  @updatedAt
}

// ============================================================
// PERSONALIZED LEARNING ENGINE (Phase 8)
//
// Post-workout only, same as Phase 7 — nothing here runs during a live
// session. This layer never mutates Form/Movement/Injury-Risk/Performance
// Engine output; it only produces separate, personalized data (adaptive
// threshold overrides, learned profile, predictions) that downstream
// systems can optionally consume later. Defaults used by the runtime
// engines (REP_TUNING, form-engine bands, etc.) are never overwritten —
// see ALGORITHM.md "Personalized Learning Engine".
// ============================================================

enum FatigueProfile {
  EASY_RECOVERY
  SLOW_RECOVERY
  FATIGUE_RESISTANT
  RAPID_FATIGUE
  INSUFFICIENT_DATA
}

enum CoachingStyle {
  STRICT
  ENCOURAGING
  TECHNICAL
  MINIMAL
  MOTIVATIONAL
}

// Distinct from the existing onboarding FitnessGoal — see ALGORITHM.md
// "Naming collisions, resolved".
enum TrainingGoal {
  STRENGTH
  HYPERTROPHY
  FAT_LOSS
  ENDURANCE
  GENERAL_FITNESS
  REHABILITATION
}

enum WeaknessClassification {
  NEW
  RECURRING
  RESOLVED
  RAPIDLY_IMPROVING
  PERSISTENT
}

// One row per user — the long-term learned profile. Trend fields
// (consistencyProfile, injuryRiskTendency, confidenceTrend,
// movementQualityTrend) are stored as plain strings, same pattern as
// Phase 6/7's TrendDirection/ProgressTrend, not a shared enum.
model UserLearningProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  experienceLevel          ExperienceLevel?
  favoriteExercises        String[]        @default([]) // exerciseIds
  weakestMovements         String[]        @default([]) // exerciseIds
  strongestMovements       String[]        @default([]) // exerciseIds
  preferredVolumeSets      Int?
  trainingFrequencyPerWeek Float?
  fatigueProfile           FatigueProfile?
  consistencyProfile       String?
  injuryRiskTendency       String?
  coachingPreference       CoachingStyle   @default(ENCOURAGING)
  confidenceTrend          String?
  movementQualityTrend     String?

  // 0..1 — how much data backs this profile, same data-availability-proxy
  // concept as the Injury Risk Engine's confidence.ts.
  learningConfidence Float @default(0)
  sessionsAnalyzed   Int   @default(0)

  updatedAt DateTime @updatedAt
}

// One row per (user, exercise-or-null, thresholdType) — a personalized
// override, never a replacement for the code-owned default it was
// computed against (defaultValueRef is stamped for traceability only).
model AdaptiveThreshold {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  thresholdType     String // e.g. "squatDepth","tempo","symmetry","rom",
                            // "consistency","fatigue","instability",
                            // "compensation","velocityLoss"
  personalizedValue Float
  defaultValueRef   Float?
  confidence        Float  @default(0)
  sampleSize        Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, exerciseId, thresholdType])
  @@index([userId, thresholdType])
}

// One row per (user, exercise-or-null, issueId) — the learned conclusion
// derived from Phase 7's WeaknessHistory (frequency/severity), not a
// duplicate of that raw tracking.
model LearnedWeakness {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  issueId               String
  classification        WeaknessClassification
  confidence            Float                   @default(0)
  recurrenceProbability Float?

  learnedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, exerciseId, issueId])
  @@index([userId, classification])
}

// One row per (user, recommendationType) — a correlation proxy for
// whether a recommendation's associated metric improved afterward; there
// is no explicit user feedback, so this is not confirmed causation. See
// ALGORITHM.md "Known limitations".
model RecommendationEffectiveness {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recommendationType String
  timesGiven         Int    @default(0)
  timesImprovedAfter Int    @default(0)
  effectivenessScore Float?

  lastGivenAt     DateTime?
  lastEvaluatedAt DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, recommendationType])
}

model GoalProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal            TrainingGoal
  targetFrequency Int?
  notes           String?

  updatedAt DateTime @updatedAt
}

// Append-only — one row per prediction run, so the prediction history
// itself is queryable, same pattern as Phase 7's PerformanceSnapshot.
model ProgressPrediction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])

  expectedImprovementPct Float?
  plateauProbability     Float?
  estimatedNextPrValue   Float?
  estimatedNextPrDate    DateTime?
  expectedRecoveryHours  Float?
  predictionConfidence   Float     @default(0)

  createdAt DateTime @default(now())

  @@index([userId, exerciseId, createdAt])
}

// ============================================================
// PROGRESS TRACKING
// ============================================================

model ProgressEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  weightKg   Float?
  bodyFatPct Float?
  chestCm    Float?
  waistCm    Float?
  hipsCm     Float?
  armsCm     Float?
  thighsCm   Float?

  @@index([userId, date])
}

model PersonalRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  weightKg   Float
  reps       Int
  achievedAt DateTime @default(now())

  @@unique([userId, exerciseId])
}

// ============================================================
// GAMIFICATION & NOTIFICATIONS
// ============================================================

model Achievement {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String
  icon        String // lucide icon name
  xpReward    Int               @default(50)
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

enum NotificationType {
  WORKOUT_REMINDER
  WATER_REMINDER
  MOTIVATION
  RECOVERY
  ACHIEVEMENT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}
